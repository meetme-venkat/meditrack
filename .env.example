# Template for .env used by docker-compose. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; this template is committed. Do not put real secrets here.

# Postgres database + root credentials (the postgres image reads these).
POSTGRES_DB=meditrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Host port mappings.
POSTGRES_HOST_PORT=5440
API_HOST_PORT=9090
