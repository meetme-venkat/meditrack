.idea/
*.iml
*.iws
*.ipr

# ─── Eclipse / Spring Tool Suite ─────────────────────────────────────────
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# ─── VS Code ─────────────────────────────────────────────────────────────
.vscode/

# ─── Claude Code ─────────────────────────────────────────────────────────
